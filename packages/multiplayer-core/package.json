{
  "version": "0.2.0",
  "name": "@xmcl/multiplayer-core",
  "private": true,
  "description": "Browser-safe shared WebRTC primitives for XMCL multiplayer",
  "exports": {
    "./codec": "./lib/codec.ts",
    "./events": "./lib/events.ts",
    "./fileTransfer": "./lib/fileTransfer.ts",
    "./localNetwork": "./lib/localNetwork.ts",
    "./logger": "./lib/logger.ts",
    "./multiplayer": "./lib/multiplayer.ts",
    "./peerConnection": "./lib/peerConnection.ts",
    "./peer": "./lib/peer.ts",
    "./peerDownload": "./lib/peerDownload.ts",
    "./room": "./lib/room.ts",
    "./selectedCandidate": "./lib/selectedCandidate.ts"
  },
  "typesVersions": {
    "*": {
      "codec": [
        "lib/codec.ts"
      ],
      "events": [
        "lib/events.ts"
      ],
      "fileTransfer": [
        "lib/fileTransfer.ts"
      ],
      "localNetwork": [
        "lib/localNetwork.ts"
      ],
      "logger": [
        "lib/logger.ts"
      ],
      "multiplayer": [
        "lib/multiplayer.ts"
      ],
      "peerConnection": [
        "lib/peerConnection.ts"
      ],
      "peer": [
        "lib/peer.ts"
      ],
      "peerDownload": [
        "lib/peerDownload.ts"
      ],
      "room": [
        "lib/room.ts"
      ],
      "selectedCandidate": [
        "lib/selectedCandidate.ts"
      ]
    }
  },
  "sideEffects": false,
  "scripts": {
    "check": "tsc --project tsconfig.json --noEmit",
    "fmt": "oxfmt -c ../../.oxfmtrc.json .",
    "lint": "oxlint -c ../oxlint-config/oxlintrc.json ."
  },
  "dependencies": {
    "@xmcl/runtime-api": "workspace:*"
  },
  "devDependencies": {
    "@xmcl/oxlint-config": "workspace:*",
    "oxlint": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "author": {
    "name": "CI010",
    "email": "cijhn@hotmail.com"
  },
  "license": "MIT"
}
