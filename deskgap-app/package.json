{
  "name": "@xmcl/deskgap-app",
  "private": true,
  "version": "0.66.2",
  "description": "DeskGap host for X Minecraft Launcher",
  "type": "module",
  "main": "./dist/main.cjs",
  "scripts": {
    "build": "tsx build.ts",
    "build:renderer": "pnpm --prefix=../xmcl-keystone-ui build",
    "check": "tsc --noEmit --project tsconfig.json",
    "dev": "pnpm build:renderer && pnpm build && tsx dev.ts",
    "start": "tsx dev.ts"
  },
  "dependencies": {
    "@xmcl/runtime": "workspace:*",
    "@xmcl/runtime-api": "workspace:*",
    "@xmcl/utils": "workspace:*",
    "graceful-fs": "^4.2.10"
  },
  "devDependencies": {
    "@types/fs-extra": "~11",
    "@types/graceful-fs": "^4.1.5",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "fs-extra": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}