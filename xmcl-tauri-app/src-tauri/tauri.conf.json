{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X Minecraft Launcher",
  "version": "0.66.2",
  "identifier": "app.xmcl.launcher",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["xmcl"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "icon": [
      "../../xmcl-electron-app/icons/light@256x256.png",
      "../../xmcl-electron-app/icons/light.ico",
      "../../xmcl-electron-app/icons/light.icns"
    ],
    "resources": {
      "../dist/sidecar.js": "dist/sidecar.js",
      "../dist/preload.js": "dist/preload.js"
    }
  }
}
