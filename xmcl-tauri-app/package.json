{
    "name": "xmcl-tauri-app",
    "private": true,
    "version": "0.66.2",
    "author": "ci010 <cijhn@hotmail.com>",
    "description": "XMCL - Tauri shell hosting the launcher runtime as a Node sidecar",
    "license": "MIT",
    "engines": {
        "node": ">=22.16.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/voxelum/x-minecraft-launcher"
    },
    "scripts": {
        "compile": "tsx build.ts",
        "build": "cross-env NODE_ENV=production cross-env BUILD_TARGET=shell tsx build.ts",
        "bundle": "cross-env NODE_ENV=production cross-env BUILD_TARGET=bundle tsx build.ts",
        "dev": "cross-env NODE_ENV=development tsx dev.ts",
        "check": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.preload.json",
        "fmt": "oxfmt -c ../.oxfmtrc.json .",
        "lint": "oxlint -c ./node_modules/@xmcl/oxlint-config/oxlintrc.json --ignore-pattern src-tauri/target --ignore-pattern dist .",
        "lint:fix": "npm run lint -- --fix"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.11.4",
        "@types/fs-extra": "~11",
        "@types/node": "^24.13.3",
        "@types/semver": "^7.3.13",
        "@types/ws": "^8.18.1",
        "@xmcl/client": "workspace:*",
        "@xmcl/core": "workspace:*",
        "@xmcl/file-transfer": "workspace:*",
        "@xmcl/installer": "workspace:*",
        "@xmcl/oxlint-config": "workspace:*",
        "@xmcl/resource": "workspace:*",
        "@xmcl/runtime": "workspace:*",
        "@xmcl/runtime-api": "workspace:*",
        "@xmcl/utils": "workspace:*",
        "@xmcl/windows-utils": "^0.0.15",
        "@xmcl/wrtc-multiplayer": "workspace:*",
        "builtin-modules": "^3.3.0",
        "create-desktop-shortcuts": "^1.10.1",
        "cross-env": "^5.2.1",
        "esbuild": "^0.28.1",
        "esbuild-plugin-yaml": "^0.0.1",
        "fast-xml-parser": "^5.7.3",
        "file-type": "^21.3.1",
        "filenamify": "^5.1.1",
        "fs-extra": "^10.1.0",
        "graceful-fs": "^4.2.10",
        "lodash.debounce": "^4.0.8",
        "node-datachannel": "0.32.3",
        "node-disk-info": "^1.3.0",
        "oxfmt": "^0.48.0",
        "oxlint": "^1.63.0",
        "semver": "^7.5.4",
        "tar-stream": "^3.1.7",
        "tslib": "^2.5.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "undici": "^7.28.0",
        "ws": "^8.18.3"
    },
    "dependencies": {
        "koffi": "^3.1.2"
    }
}
